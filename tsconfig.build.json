{
	// The package as it is published: JavaScript and its declarations in dist/, lowered so Node 22 runs it (Node 22
	// has no `await using`), every relative `.ts` import written as `.js`. The stage is published as it is written
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"target": "ES2022",
		"noEmit": false,
		"declaration": true,
		"rewriteRelativeImportExtensions": true,
		"rootDir": "src",
		"outDir": "dist"
	},
	"include": ["src/**/*"]
}

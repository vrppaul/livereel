{
	"name": "livereel",
	"version": "0.1.0",
	"description": "Film a live web page: a camera, a light, a cursor and captions over it, frame by frame",
	"license": "MIT",
	"author": "Pavel Paranin <pavel@paran.in>",
	"type": "module",
	"engines": {
		"node": ">=22.20"
	},
	"bin": {
		"livereel": "./bin/livereel.js"
	},
	"files": [
		"bin",
		"dist",
		"stage",
		"examples"
	],
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"livereel": "node -C source src/cli/main.ts",
		"build": "tsc -p tsconfig.build.json",
		"prepack": "pnpm build",
		"postpack": "rm -rf dist",
		"check": "tsc --noEmit -p .",
		"lint": "eslint . && stylelint 'stage/*.css'",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"knip": "knip",
		"test": "vitest run"
	},
	"dependencies": {
		"playwright-core": "^1.64.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.5",
		"eslint": "^10.13.0",
		"knip": "^6.43.0",
		"prettier": "^3.9.10",
		"stylelint": "^17.16.0",
		"stylelint-config-standard": "^40.0.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vitest": "^5.0.5"
	}
}

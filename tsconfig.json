{
	// The whole program as the type checker reads it: the package's source, the stage's script and the films.
	// Development runs the source as it stands, so every import names a .ts file; a film imports `livereel` itself,
	// which the `source` condition takes to src/ (`node -C source`)
	"compilerOptions": {
		// The stage's script is JavaScript the page runs as it stands, its types written in JSDoc
		"allowJs": true,
		"checkJs": true,
		"target": "ESNext",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"customConditions": ["source"],
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"types": ["node"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"verbatimModuleSyntax": true,
		// Node runs a .ts file by stripping its types: nothing may need turning into other JavaScript
		"erasableSyntaxOnly": true,
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["src/**/*", "stage/*.js", "examples/**/*", "vitest.config.ts", "knip.ts"]
}
